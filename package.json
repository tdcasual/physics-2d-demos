{
  "name": "physics-2d-demos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "check:scenes": "tsx scripts/check-scenes.ts",
    "check:layouts": "tsx scripts/check-layouts.ts",
    "check:bundle": "tsx scripts/check-bundle-budget.ts",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "new:scene": "tsx scripts/new-scene.ts",
    "quality:core": "pnpm check:scenes && pnpm check:layouts && pnpm check:circular && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle",
    "export:standalone": "vite build --config vite.config.standalone.ts",
    "quality:full": "pnpm check:scenes && pnpm check:layouts && pnpm check:circular && pnpm lint && pnpm typecheck && pnpm test && pnpm test:coverage && pnpm build && pnpm check:bundle && pnpm test:e2e && pnpm test:visual",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "^10.4.27",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "postcss": "^8.5.8",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-bundle-analyzer": "^1.3.7",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
